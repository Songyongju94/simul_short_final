{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run.py - signaldetector",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": [
        "signaldetector",
        "signaldetector.log"
      ],
      "cwd": "${workspaceFolder}",
      "python": "C:/Python310/python.exe",
      "console": "integratedTerminal",
      "pythonArgs": [
        "-X",
        "utf8"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
